# Restart scrolltune when a mouse-like USB or Bluetooth device appears or disappears.
# This ensures the service re-grabs the mouse after topology changes.
# To limit to a specific device, add ATTRS{idVendor} and ATTRS{idProduct} filters.
# Bluetooth uses virtual/misc/uhid; exclude only virtual/input devices from uinput.
ACTION=="add", SUBSYSTEM=="input", KERNEL=="event*", DEVPATH!="*/virtual/input/*", ENV{ID_INPUT_MOUSE}=="1", RUN+="/usr/bin/systemctl restart scrolltune.service"
ACTION=="remove", SUBSYSTEM=="input", KERNEL=="event*", DEVPATH!="*/virtual/input/*", ENV{ID_INPUT_MOUSE}=="1", RUN+="/usr/bin/systemctl restart scrolltune.service"
