# Restart scrolltune when a USB input device appears.
# This ensures the service re-grabs the mouse after a replug.
# To limit to a specific device, add ATTRS{idVendor} and ATTRS{idProduct} filters.
# Only trigger on real USB devices, not virtual ones created by uinput
ACTION=="add", SUBSYSTEM=="input", KERNEL=="event*", DEVPATH!="*virtual*", RUN+="/usr/bin/systemctl restart scrolltune.service"
